# 运行配置。密钥通过环境变量或运行目录 data/ 提供。

# 运行数据目录（挂载卷）
DATA_DIR=/app/data

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# 调用方标识（ClawBot base_info.bot_agent）
BOT_AGENT=ClawBot/0.1.0

# 扫码登录页（仅监听本机，建议用 SSH 隧道访问）
LOGIN_PAGE_ENABLED=1
LOGIN_PAGE_HOST=127.0.0.1
LOGIN_PAGE_PORT=8080

# 容器内 SSH（由 entrypoint 写入）
# 二选一：公钥或密码
SSH_AUTHORIZED_KEYS=
SSH_ROOT_PASSWORD=
